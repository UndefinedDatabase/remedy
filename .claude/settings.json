{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.data/**)",
      "Read(./.claude/settings.local.json)"
    ]
  },
  "disableSkillShellExecution": true
}
