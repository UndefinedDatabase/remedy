++
++def _task(tid: str = "T1", **overrides) -> dict:
++    base = {
++        "id": tid,
++        "title": f"Task {tid}",
++        "goal": f"Do {tid}",
++        "acceptance": [f"{tid} done"],
++        "depends_on": [],
++        "est_tokens_band": "M",
++        "files_hint": [],
++    }
++    base.update(overrides)
++    return base
++
++
++def _plan(**overrides) -> dict:
++    base = {
++        "schema_v": "flight_plan_v1",
++        "tasks": [_task()],
++        "risks": [],
++    }
++    base.update(overrides)
++    return base
++
