++class PlannedTask(_Strict):
++    """One task in a FlightPlan DAG."""
++
++    id: str
++    title: str
++    goal: str
++    acceptance: list[str] = Field(min_length=1)
++    depends_on: list[str] = Field(default_factory=list)
++    est_tokens_band: TokenBand
