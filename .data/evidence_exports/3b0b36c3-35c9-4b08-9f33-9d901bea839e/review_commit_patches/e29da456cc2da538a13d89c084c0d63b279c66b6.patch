+class RecordingLog:
+    def __init__(self) -> None:
+        self.events: list[tuple[str, dict]] = []
+
+    def log(self, event: str, **meta) -> None:
+        self.events.append((event, meta))
+
+    def of(self, name: str) -> list[dict]:
+        return [meta for event, meta in self.events if event == name]
