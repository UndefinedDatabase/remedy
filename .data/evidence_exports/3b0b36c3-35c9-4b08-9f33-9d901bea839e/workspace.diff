+def isolate_data_root(tmp_path: Path, monkeypatch) -> Path:
+    """Every cycle writes evidence — no test may reach the real data root."""
+    data_dir = tmp_path / "remedy_data"
+    data_dir.mkdir()
+    monkeypatch.setenv("REMEDY_DATA_DIR", str(data_dir))
+    return data_dir
