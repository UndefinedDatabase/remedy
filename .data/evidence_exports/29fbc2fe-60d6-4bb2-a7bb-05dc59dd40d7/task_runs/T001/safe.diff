+# ---------------------------------------------------------------------------
+# Write failure must not escape the cycle
+# ---------------------------------------------------------------------------
+
+
+class TestWriteFailureIsContained:
+    def test_record_cycle_checkpoint_returns_the_reason_instead_of_raising(
+            self, monkeypatch):
+        def boom(*_a, **_kw):
+            raise OSError("disk full")
