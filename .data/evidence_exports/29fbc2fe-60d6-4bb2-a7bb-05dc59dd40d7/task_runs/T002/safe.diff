+            f"Error: plan awaiting approval. "
+            f"Run: remedy decision resolve {job_id_str[:8]} fp:approval "
+            f"--reason approve",
+            file=sys.stderr,
+        )
+        sys.exit(3)
+    if block_reason == "rejected":
+        print(
+            f"Error: flight plan rejected. Run: remedy do replan {job_id_str[:8]}",
+            file=sys.stderr,
+        )
+        sys.exit(3)
+
