+                  default=0)
+    try:
+        from packages.orchestration.checkpoints import _index_of_path, checkpoint_paths
+
+        highest = max(highest,
+                      *(_index_of_path(p) for p in checkpoint_paths(job_id)), 0)
+    except Exception:  # noqa: BLE001 — numbering must not depend on checkpoints
+        pass
+    return highest + 1
+
