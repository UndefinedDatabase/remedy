+        assert proc.returncode == 1
+        assert "not found" in proc.stderr
+
+    def test_rm_against_an_empty_queue_says_there_is_no_queue(self, project):
+        data_root, project_id = project
+        proc = _run(["queue", "rm", "deadbeef", "--project", project_id],
