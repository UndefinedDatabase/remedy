+            raise AnswerParseError(
+                f"malformed --answer {text!r}: expected <question-id>=<answer>, "
+                'e.g. --answer q1="use PostgreSQL"')
+        qid, _, value = text.partition("=")
+        qid = qid.strip()
+        if not qid:
+            raise AnswerParseError(
+                f"malformed --answer {text!r}: missing question id before '='")
+        if qid not in known:
