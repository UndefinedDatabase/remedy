+        f"{counts[_SOURCE_DEFAULT]} default, "
+        f"{counts[_SOURCE_PLANNER]} planner, "
+        f"{counts[_SOURCE_OPEN]} unresolved.")
+    lines.append("")
+    return "\n".join(lines)
