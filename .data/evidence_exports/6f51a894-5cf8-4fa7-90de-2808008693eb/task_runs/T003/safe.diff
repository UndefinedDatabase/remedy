+def _valid_plan_json(n_tasks: int = 3) -> str:
+    tasks = []
+    for i in range(n_tasks):
+        tid = f"T{i + 1:03d}"
+        deps = [f"T{i:03d}"] if i > 0 else []
+        tasks.append({
+            "id": tid,
+            "title": f"Task {i + 1}",
+            "goal": f"Do thing {i + 1}",
+            "acceptance": [f"Thing {i + 1} done"],
+            "depends_on": deps,
+            "est_tokens_band": "M",
+            "files_hint": [f"src/file{i + 1}.py"],
+        })
+    return json.dumps({
+        "schema_v": "flight_plan_v1",
+        "tasks": tasks,
+        "risks": ["timeline risk"],
+    })
+
