+            task_step=step, verify=passing_verify, clock=FakeClock(),
+            save=no_save, control_root_path=control_root,
+        )
+        # Task 2 failed, so task 3 (its successor in the legacy chain) is
+        # skipped-blocked rather than run out of order.
