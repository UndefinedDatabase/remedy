+class FakeProvider:
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def __call__(self, context: TaskExecutionContext) -> BuilderOutput:
+        self.calls += 1
+        return BuilderOutput(summary=f"did {context.task_description}",
+                            proposed_changes=["change"])
