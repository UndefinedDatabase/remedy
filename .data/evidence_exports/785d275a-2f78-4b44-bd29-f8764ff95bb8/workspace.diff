+def escalate(job: Job, task_index: int = 0, *, question: str = "Which database?",
+             options=("postgres", "sqlite"), safe_default: str = "",
+             now: datetime = T0) -> dict:
+    return enqueue_task_decision(
+        job,
+        task_id=job.tasks[task_index].id,
