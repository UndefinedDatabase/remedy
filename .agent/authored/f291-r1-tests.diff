+
+    def _tree(self, tmp_path: Path) -> Path:
+        root = tmp_path / "src"
+        _write_source(root, "packages/zeta.py", _handler_module("z"))
+        _write_source(root, "apps/alpha.py", _handler_module("a1", "a2"))
+        _write_source(root, "scripts/beta.py", _handler_module("b"))
+        return root
