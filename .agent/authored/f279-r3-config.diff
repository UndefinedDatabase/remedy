     if spec.value_type is bool:
-        return raw.lower() in ("1", "true", "yes")
+        return raw.lower() in BOOL_TRUE_WORDS
     if spec.value_type is list:
         return [s.strip() for s in raw.split(",") if s.strip()]
     return raw
