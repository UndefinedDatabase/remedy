+def _lines_a_diff_adds_to_the_ledger(diff: str) -> str:
+    added, in_ledger = [], False
+    for line in diff.splitlines():
+        if line.startswith("+++ "):
+            in_ledger = line[4:].strip() == f"b/{LEDGER_PATH}"
+        elif in_ledger and line.startswith("+"):
+            added.append(line[1:])
+    return "\n".join(added)
+
+
+def _ledger_payload_ids(ctx: BlockContext) -> tuple[set[str], set[str]]:
+    """The ids the block's own text and its ledger payloads register and resolve.
+
+    A payload is a file the block's payload table names, read from the payload directory
+    the block names. A `.diff` payload contributes the lines it ADDS to the ledger and
+    nothing else; any other payload counts only when its name begins `ledger`, the name
+    this workflow gives a slice appended to the ledger whole. A plan or a decision that
+    quotes a registration therefore registers nothing.
+    """
+    texts = [ctx.text]
+    for directory in sorted(set(_PAYLOAD_DIR.findall(ctx.text))):
+        for name in sorted({row[0].strip() for row in _PAYLOAD_ROW.findall(ctx.text)}):
+            if name.endswith(".diff"):
+                texts.append(_lines_a_diff_adds_to_the_ledger(ctx.read(f"{directory}/{name}")))
+            elif name.startswith("ledger"):
+                texts.append(ctx.read(f"{directory}/{name}"))
+    joined = "\n".join(texts)
+    return set(_REGISTRATION.findall(joined)), set(_RESOLUTION.findall(joined))
+
