+def listeners_inside(port: int, root: Path) -> list[int]:
+    """The pids listening on ``port`` whose working directory is inside ``root``."""
+    inside = []
+    for conn in psutil.net_connections(kind="tcp"):
+        if conn.status != psutil.CONN_LISTEN or not conn.laddr or conn.laddr.port != port:
+            continue
+        try:
+            cwd = Path(psutil.Process(conn.pid).cwd()).resolve() if conn.pid else None
+        except (psutil.NoSuchProcess, psutil.AccessDenied):
+            cwd = None
+        if cwd is not None and cwd.is_relative_to(root.resolve()):
+            inside.append(conn.pid)
+    return inside
+
+
+def assert_the_app_left_nothing_behind(ev, root: Path) -> None:
+    """Teardown judged by the harness's own sweep and by every port the run used.
+
+    R-0950: this worker's own port must be closed. A port `choose_port` fell back to comes from
+    the machine's shared pool, and another process may bind that number the moment this app
+    releases it, which is not a zombie of this test; so an open fallback port fails only when
+    the process listening on it runs inside this test's project.
+    """
+    tail = ev.output_tail
+    assert "the application family was stopped" in tail, tail
+    assert "processes survived the cleanup" not in tail, tail
+    own_port = worker_port(_SMOKE_PORT_OFFSET)
+    for part in tail.split("port=")[1:]:
+        port = int(part.split(")")[0])
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+            sock.settimeout(2.0)
+            is_open = sock.connect_ex(("127.0.0.1", port)) == 0
+        if port == own_port:
+            assert not is_open, f"port {port} still open"
+        elif is_open:
+            assert listeners_inside(port, root) == [], f"port {port} still held by this app"
+
