--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -44,6 +44,7 @@ jobs:
         with:
           python-version: ${{ matrix.python-version }}
           cache: pip
+          cache-dependency-path: constraints.txt
 
       - uses: actions/setup-node@v4
         with:
@@ -67,8 +68,21 @@ jobs:
       # NOTE: this comment deliberately spells no stage marker expression — the
       # workflow must name no test selection of its own, which
       # tests/orchestration/test_ci_workflow.py enforces by substring.
-      - name: Install Remedy with its dev and local-client extras
-        run: python3 -m pip install -e ".[dev,ollama]"
+      # DECISION F279 D1: the toolchain is HASH-PINNED. `constraints.txt` is generated
+      # from the dev and local-client extras by the command in its own header, and one
+      # hash in a requirements file puts pip into hash-checking mode for the whole
+      # install, which refuses an editable one. So the pinned set is installed first
+      # and by itself, a changed artifact failing the step; Remedy follows with no
+      # dependency resolution at all; and `pip check` fails the job if the pinned set
+      # does not cover what `pyproject.toml` declares.
+      - name: Install the hash-pinned toolchain
+        run: python3 -m pip install --require-hashes -r constraints.txt
+
+      - name: Install Remedy itself, resolving nothing
+        run: python3 -m pip install --no-deps -e .
+
+      - name: Check the pinned set covers every declared dependency
+        run: python3 -m pip check
 
       # DECISION F083 D6: the UI toolchain is a PRECONDITION of the `ui` stage,
       # not a part of it. Without this install the stage's tsc check skips here
