+
+def _job(project_id: str | None = None, name: str = "j") -> Job:
+    return Job(name=name, project_id=project_id)
+
+
+PROJ_A = str(uuid4())
+PROJ_B = str(uuid4())
+
+
+# ---------------------------------------------------------------------------
