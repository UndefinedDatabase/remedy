+# ---------------------------------------------------------------------------
+# R-0109: stats-failures scoping tests
+# ---------------------------------------------------------------------------
+
+
+class TestCollectFailuresJobIds:
+    """Unit test: collect_failures(job_ids=...) filters by job directory."""
+
+    def test_job_ids_filter_excludes_unmatched(self, tmp_path):
+        from packages.orchestration.failure_stats import collect_failures
+
+        job_a = str(uuid4())
+        job_b = str(uuid4())
+
+        for jid in (job_a, job_b):
+            job_dir = tmp_path / jid
+            job_dir.mkdir()
+            (job_dir / "postmortem.json").write_text(json.dumps({
+                "postmortem_v": 1,
+                "scope": "job",
+                "failure_class": "test",
+                "raw_reason": f"fail in {jid[:8]}",
+            }))
+
+        result_all = collect_failures(root=tmp_path)
+        assert result_all["coverage"]["jobs_scanned"] == 2
+        assert result_all["total_postmortems"] == 2
+
+        result_a = collect_failures(root=tmp_path, job_ids={job_a})
+        assert result_a["coverage"]["jobs_scanned"] == 1
+        assert result_a["total_postmortems"] == 1
+
+        result_empty = collect_failures(root=tmp_path, job_ids=set())
+        assert result_empty["coverage"]["jobs_scanned"] == 0
+        assert result_empty["total_postmortems"] == 0
+
+
+class TestStatsFailuresScopedCLI:
+    """CLI subprocess test: stats failures respects --project flag."""
+
+    def test_stats_failures_scoped_by_project(self, tmp_path):
+        data_dir = tmp_path / "data"
+        env = _env(data_dir)
+
+        repo_a = _git_repo(tmp_path, "alpha")
+        repo_b = _git_repo(tmp_path, "beta")
+        _init_project(repo_a, env)
+        _init_project(repo_b, env)
+        slug_b = _get_project_slug(repo_b, env)
+
+        _create_job(repo_a, env, "alpha stats job")
+        _create_job(repo_b, env, "beta stats job")
+
+        result = _run_cli(
+            ["stats", "failures", "--project", slug_b, "--json"],
+            env, cwd=str(repo_a),
+        )
+        assert result.returncode == 0
+        data = json.loads(result.stdout)
+        assert "total_postmortems" in data
